+const LONG_REASON = "Printing and binding for the quarterly planning workshop, two copies each, collected at the front desk before noon";
+
+function pay(id: string, over: Partial<Payment>): Payment {
+  const made = over.created_at ?? min(-30);
+  return {
+    refund_until: new Date(Date.parse(made) + 24 * 3600_000).toISOString(), // 24 hours after it was made, as the server says
+    id,
+    created_at: min(-30),
+    amount_cents: 1200,
+    currency: "usd",
+    payee: "Corner Café",
+    reason: "team coffee",
+    status: "paid",
+    stripe_id: `pi_3Qprev${id.slice(0, 6)}`,
+    capture_at: null,
+    captured_at: min(-20),
+    canceled_at: null,
+    refunded_cents: 0,
+    refund_left_cents: 1200,
+    dispute: null,
+    actions: ["refund", "problem", "evidence"],
+    test_mode: true,
+    ...over,
+  };
+}
+
+const ev = (at: number, kind: string, source: PaymentEvent["source"], note: string | null = null, amount: number | null = null): PaymentEvent => ({ at: min(at), kind, source, amount_cents: amount, ref: null, note });
+
+function sample(long: boolean): PaymentDetail[] {
+  const first = pay("3f2b8c1e-5d4a-4c3b-9a2e-1f0e9d8c7b6a", { created_at: min(-2), captured_at: min(-2), ...(long ? { payee: LONG_PAYEE, reason: LONG_REASON, amount_cents: 5000, refund_left_cents: 5000 } : {}) });
+  return [
+    { payment: first, events: [ev(-2, "approved", "you", `${first.payee}: ${first.reason}`, first.amount_cents), ev(-2, "paid", "atlas", null, first.amount_cents)] },
+    {
+      payment: pay("4a1b2c3d-0000-4000-8000-000000000002", { created_at: min(-90), payee: "City Books", reason: "two paperbacks", amount_cents: 2400, status: "partially_refunded", refunded_cents: 900, refund_left_cents: 1500 }),
+      events: [ev(-90, "approved", "you", "City Books: two paperbacks", 2400), ev(-90, "paid", "atlas", null, 2400), ev(-40, "refunded", "you", "Paid twice", 900)],
+    },
+    {
+      payment: pay("4a1b2c3d-0000-4000-8000-000000000003", { created_at: min(-200), payee: "Print Shop", reason: "poster prints", amount_cents: 1800, status: "paid", refund_left_cents: 1800, dispute: { id: "du_prev000001", status: "needs_response", open: true }, actions: ["problem", "evidence"] }),
+      events: [ev(-200, "approved", "you", "Print Shop: poster prints", 1800), ev(-200, "paid", "atlas", "Paid with Stripe's dispute test card.", 1800), ev(-185, "dispute_opened", "stripe", "The bank says the card's owner didn't make this payment.", 1800), ev(-120, "problem_reported", "you", "Not what I approved: they printed the wrong size")],
+    },
+    {
+      payment: pay("4a1b2c3d-0000-4000-8000-000000000004", { created_at: min(-300), payee: "Green Grocer", reason: "fruit for the office", amount_cents: 650, status: "refunded", refunded_cents: 650, refund_left_cents: 0, actions: ["problem", "evidence"] }),
+      events: [ev(-300, "approved", "you", "Green Grocer: fruit for the office", 650), ev(-300, "paid", "atlas", null, 650), ev(-250, "refunded", "you", "Didn't want it", 650)],
+    },
+    {
+      payment: pay("4a1b2c3d-0000-4000-8000-000000000005", { created_at: min(-26 * 60), payee: "Bike Repair", reason: "tune-up deposit", amount_cents: 2000, status: "canceled", captured_at: null, canceled_at: min(-26 * 60 + 4), refund_left_cents: 0, actions: ["problem", "evidence"] }),
+      events: [ev(-26 * 60, "approved", "you", "Bike Repair: tune-up deposit", 2000), ev(-26 * 60, "held", "atlas"), ev(-26 * 60 + 4, "canceled", "you", "You canceled the hold; no money moved.")],
+    },
+    {
+      payment: pay("4a1b2c3d-0000-4000-8000-000000000006", { created_at: min(-28 * 60), payee: "Ticket Desk", reason: "museum entry", amount_cents: 1500, status: "failed", stripe_id: null, captured_at: null, refund_left_cents: 0, actions: ["problem", "evidence"] }),
+      events: [ev(-28 * 60, "approved", "you", "Ticket Desk: museum entry", 1500), ev(-28 * 60, "declined", "atlas", "The test card was declined (Your card was declined.).")],
+    },
+  ];
+}
+
+export function paymentsFakes(params: URLSearchParams, ok: <T>(v: T) => Promise<T>) {
+  const mode = params.get("payments");
+  const long = mode === "long" || params.get("paid") === "long";
+  const all = mode === "empty" ? [] : sample(long);
+  let limits: PaymentLimits = { per_payment_cents: 2000, per_day_cents: 5000, per_day_count: 5, test_card: "visa", max: { per_payment_cents: 5000, per_day_cents: 5000, per_day_count: 5 } };
+  const off = () => Promise.reject(new ApiError(404, "not found"));
+  const find = (id: string) => all.find((d) => d.payment.id === id);
+  const one = (id: string) => (find(id) ? ok(structuredClone(find(id)!)) : Promise.reject(new ApiError(404, "not found")));
+  return {
+    payments: (): Promise<PaymentList> => (mode === "off" ? off() : ok({ enabled: true, test_mode: true, limits, items: all.map((d) => d.payment) })),
+    payment: one,
+    refundPayment: (id: string, body: RefundIn = {}) => {
+      const d = find(id);
+      if (!d) return ok({ refunded: true, payment_id: id, refund_id: "re_preview000001", amount: "$12.00" });
+      const cents = body.amount_cents ?? d.payment.refund_left_cents;
+      const done = d.payment.refunded_cents + cents;
+      const status = done >= d.payment.amount_cents ? "refunded" : "partially_refunded";
+      d.payment = { ...d.payment, refunded_cents: done, refund_left_cents: d.payment.amount_cents - done, status, actions: status === "refunded" ? ["problem", "evidence"] : d.payment.actions };
+      d.events.push(ev(0, "refunded", "you", "Didn't want it", cents));
+      return ok({ refunded: true, payment_id: id, refund_id: "re_preview000001", amount: `$${(cents / 100).toFixed(2)}`, left_cents: d.payment.refund_left_cents, status });
+    },
+    reportPayment: (id: string, body: { reason: string; note?: string }) => {
+      const d = find(id)!;
+      d.events.push(ev(0, "problem_reported", "you", body.note ? `Something else: ${body.note}` : "Something else"));
+      return ok(structuredClone(d));
+    },
+    paymentEvidence: () => ok(new Blob(["{}"], { type: "application/json" })),
+    paymentLimits: () => ok(limits),
+    setPaymentLimits: (b: LimitsIn) => {
+      limits = { ...limits, per_payment_cents: b.per_payment_cents, per_day_cents: b.per_day_cents, per_day_count: b.per_day_count, test_card: b.test_card };
+      return ok(limits);
+    },
+  };
+}
+
+/** The pay step's chip under an answer (charged at once: no hold time); &paid=long the worst case. */
+export function paidChipOf(params: URLSearchParams) {
+  const long = params.get("paid") === "long";
+  return {
+    kind: "paid",
+    amount_cents: long ? 5000 : 1200,
+    currency: "usd",
+    payee: long ? LONG_PAYEE : "Corner Caf\u00e9",
+    payment_id: "3f2b8c1e-5d4a-4c3b-9a2e-1f0e9d8c7b6a",
+    refund_until: min(-2 + 24 * 60), // 24 hours after the sample payment was made (2 minutes ago)
+  };
+}
