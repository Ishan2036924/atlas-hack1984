+// The spoken answer to the end card: a short plain yes only; any no-word anywhere is a no; long talk is nothing.
+import { describe, expect, it } from "vitest";
+
+import type { RunCard } from "../../../lib/agentRun";
+import { askAloud } from "../words";
+import { answerOf, echoOf } from "./voiceAnswer";
+
+describe("answerOf", () => {
+  it("hears a short plain yes", () => {
+    for (const w of ["send it", "Send it.", "yes", "Yes, send it", "go ahead", "okay send", "sure", "send both"]) expect(answerOf(w), w).toBe("yes");
+  });
+  it("hears any no, wherever it is (a no always wins)", () => {
+    for (const w of ["no", "not now", "don't send it", "yes but don't send", "wait", "cancel", "stop", "send it no wait", "never mind"]) expect(answerOf(w), w).toBe("no");
+  });
+  it("hears nothing in other words, long talk, or silence", () => {
+    for (const w of ["", "   ", "hmm", "what does it say", "send it to everyone in my contacts please now", "sam", "the email"]) expect(answerOf(w), w).toBeNull();
+  });
+});
+
+describe("Atlas's own question is never an answer", () => {
+  const card = (verb: string, recipients: string[], n: number) => ({ verb, recipients, items: Array.from({ length: n }, (_, i) => ({ title: `Item ${i}` })) }) as unknown as RunCard;
+  const cards = [card("send", ["Sam"], 1), card("send", ["Sam Rivera"], 1), card("send", ["Sam", "Lee"], 2), card("change", ["Sam"], 1), card("do", [], 1), card("mixed", ["Sam"], 2)];
+  it("no part of any question reads as a yes, even heard alone", () => {
+    for (const c of cards) {
+      const q = askAloud(c)
+        .toLowerCase()
+        .replace(/[^a-z' ]+/g, " ")
+        .split(" ")
+        .filter(Boolean);
+      for (let i = 0; i < q.length; i++) for (let j = i + 1; j <= q.length; j++) expect(answerOf(q.slice(i, j).join(" ")), q.slice(i, j).join(" ")).not.toBe("yes");
+    }
+  });
+  it("its echo is ignored; the person's own answer is heard", () => {
+    const asked = askAloud(card("send", ["Sam"], 1));
+    for (const w of ["It's ready for Sam", "should it go now", "Sam"]) {
+      expect(echoOf(w, asked), w).toBe(true);
+      expect(answerOf(w, asked), w).toBeNull();
+    }
+    for (const w of ["send it", "yes", "go ahead"]) {
+      expect(echoOf(w, asked), w).toBe(false);
+      expect(answerOf(w, asked), w).toBe("yes");
+    }
+    expect(answerOf("no", asked)).toBe("no");
+    // a name that is itself a yes word ("Sure"): the question is heard back, and still is no answer
+    expect(answerOf("Sure", askAloud(card("send", ["Sure"], 1)))).toBeNull();
+  });
+});
