index 00000000..b3f0e14a
--- /dev/null
+++ b/web/src/lib/agentScores.test.ts
@@ -0,0 +1,55 @@
+import { describe, expect, it } from "vitest";
+
+import { howItRan, learningLine, MIN_JUDGED, NO_WORDS, reasonsFor, safetyLine, scoreDetail, toImprove, toRunScores, workingOn } from "./agentScores";
+
+const base = { window_days: 28, judged: 12, average: 86.3, unsafe: 0, common: [], last: [] };
+
+describe("agentScores", () => {
+  it("reads the server's answer and drops what isn't a score", () => {
+    const s = toRunScores({ judged: 3, average: 71.5, unsafe: 0, common: [{ reason: "tool_errors", runs: 2 }, { runs: 1 }], last: [{ run_id: 9, score: 70, safety_ok: true, reasons: ["tool_errors", 4] }, { score: 1 }] });
+    expect(s.common).toEqual([{ reason: "tool_errors", runs: 2 }]);
+    expect(s.last).toEqual([{ run_id: 9, score: 70, safety_ok: true, reasons: ["tool_errors"] }]);
+    expect(toRunScores(null)).toEqual({ window_days: 28, judged: 0, average: null, unsafe: 0, common: [], last: [] });
+  });
+
+  it("says how it ran in three calm words, and nothing while it's too early to tell", () => {
+    expect(howItRan(base)).toBe("Going well");
+    expect(howItRan({ ...base, average: 70 })).toBe("Mostly well");
+    expect(howItRan({ ...base, average: 58.4 })).toBe("Could be better");
+    expect(howItRan({ ...base, judged: MIN_JUDGED - 1 })).toBeNull();
+    expect(scoreDetail(base)).toBe("86 of 100 over 12 runs in the last 4 weeks");
+    expect(scoreDetail({ ...base, judged: 1 })).toBeNull();
+  });
+
+  it("says it asked first only for an agent that asks, and always names a run to look at", () => {
+    expect(safetyLine(base, true)).toBe("Asked you first every time.");
+    expect(safetyLine(base, false)).toBeNull();
+    expect(safetyLine({ ...base, unsafe: 1 }, false)).toBe("1 run to look at: it acted without a yes on record.");
+  });
+
+  it("never counts your own no as something to fix: it's what the agent learns from", () => {
+    const s = { ...base, common: [{ reason: "said_no", runs: 2 }, { reason: "no_wrong_time", runs: 2 }, { reason: "big_edit", runs: 1 }] };
+    expect(toImprove(s)).toBe("Its drafts needed your edits once");
+    expect(learningLine(s)).toBe("It's learning a better time to ask.");
+    expect(toImprove({ ...base, common: [{ reason: "said_no", runs: 3 }] })).toBeNull();
+    expect(toImprove({ ...base, common: [{ reason: "acted_without_yes", runs: 1 }, { reason: "tool_errors", runs: 4 }] })).toBe("A step failed in 4 runs");
+    expect(workingOn({ ...base, common: [{ reason: "tool_errors", runs: 4 }] })).toBe("A step sometimes fails. It's working on that.");
+    expect(workingOn({ ...base, common: [{ reason: "said_no", runs: 4 }] })).toBeNull();
+  });
+
+  it("offers the reasons that fit the action, at most four and then Something else", () => {
+    expect(reasonsFor("email")).toEqual(["wrong_person", "wrong_time", "wrong_words", "not_needed", "other"]);
+    expect(reasonsFor("payment")).toEqual(["wrong_amount", "wrong_time", "not_needed", "other"]);
+    expect(reasonsFor(undefined)).toEqual(["wrong_time", "wrong_words", "not_needed", "other"]);
+    for (const k of ["email", "payment", "invite", "slack", "event", "page", undefined]) {
+      const r = reasonsFor(k);
+      expect(r.length).toBeLessThanOrEqual(5);
+      expect(r.at(-1)).toBe("other");
+      for (const code of r) expect(NO_WORDS[code]).toBeTruthy();
+    }
+  });
+
+  it("never names an amount of money (D241)", () => {
+    expect(Object.values(NO_WORDS).join(" ")).not.toMatch(/\$|usd|cents|budget|spend|cost/i);
+  });
+});
diff --git a/web/src/lib/agentScores.ts b/web/src/lib/agentScores.ts
new file mode 100644
index 00000000..522d8657
--- /dev/null
+++ b/web/src/lib/agentScores.ts
@@ -0,0 +1,135 @@
+// How the judge scored an agent's runs (the learning loop; GET /v1/agents/{id}/scores, lifeos.judge rubric r1), read
+// into plain fields, and the calm words the agent's page shows. Scores and reason codes only: the judge never reads a
+// run's content, and nothing here names an amount (D241). Saying no is the person in charge, never the agent's defect:
+// a "no" shows as what the agent is learning, never as something to fix.
+
+export type ScoreLine = { run_id: number; score: number; safety_ok: boolean; reasons: string[] };
+export type RunScores = {
+  window_days: number;
+  judged: number;
+  average: number | null;
+  unsafe: number;
+  common: { reason: string; runs: number }[];
+  last: ScoreLine[];
+};
+
+/** below this many judged runs it's too early to tell, so the page says nothing about scores */
+export const MIN_JUDGED = 3;
+
+const obj = (v: unknown): Record<string, unknown> => (typeof v === "object" && v !== null && !Array.isArray(v) ? (v as Record<string, unknown>) : {});
+const num = (v: unknown, d = 0): number => (typeof v === "number" && Number.isFinite(v) ? v : d);
+const strs = (v: unknown): string[] => (Array.isArray(v) ? v.filter((x): x is string => typeof x === "string") : []);
+
+export function toRunScores(raw: unknown): RunScores {
+  const o = obj(raw);
+  return {
+    window_days: num(o.window_days, 28),
+    judged: num(o.judged),
+    average: typeof o.average === "number" && Number.isFinite(o.average) ? o.average : null,
+    unsafe: num(o.unsafe),
+    common: (Array.isArray(o.common) ? o.common : []).map(obj).filter((c) => typeof c.reason === "string").map((c) => ({ reason: c.reason as string, runs: num(c.runs) })),
+    last: (Array.isArray(o.last) ? o.last : [])
+      .map(obj)
+      .filter((r) => typeof r.run_id === "number")
+      .map((r) => ({ run_id: r.run_id as number, score: num(r.score), safety_ok: r.safety_ok !== false, reasons: strs(r.reasons) })),
+  };
+}
+
+const plural = (n: number, word: string): string => `${n} ${word}${n === 1 ? "" : "s"}`;
+
+// what can get better, said about the agent; the person's own "no" and the safety codes are never here
+const IMPROVE: Record<string, string> = {
+  tried_blocked_action: "It tried something it isn't allowed to",
+  did_not_finish: "It didn't finish",
+  stopped: "It was stopped",
+  tool_errors: "A step failed",
+  claimed_done_on_failure: "It said done when it wasn't",
+  over_run_cap: "It used more AI than a run allows",
+  too_many_steps: "It took more steps than a run allows",
+  too_slow: "It took longer than a run allows",
+  thumbs_down: "A run wasn't right for you",
+  big_edit: "Its drafts needed your edits",
+};
+// what a "no" teaches it, by the reason the person gave
+const LEARNING: Record<string, string> = {
+  wrong_person: "It's learning who to send things to.",
+  wrong_time: "It's learning a better time to ask.",
+  wrong_words: "It's learning how you like things worded.",
+  wrong_amount: "It's learning the amounts you expect.",
+  not_needed: "It's learning what you don't need.",
+};
+
+// why you said no, as the chips say it (NO_REASONS in lifeos.learnsignals; not_now and not_safe stay server codes)
+export const NO_WORDS: Record<string, string> = {
+  wrong_person: "Wrong person",
+  wrong_time: "Wrong time",
+  wrong_words: "Wrong words",
+  wrong_amount: "Wrong amount",
+  not_needed: "Not needed",
+  other: "Something else",
+};
+
+/** the reasons that fit the action (at most four, then "Something else"): an email isn't the wrong amount */
+export function reasonsFor(kind: string | undefined): string[] {
+  const fit: Record<string, string[]> = {
+    email: ["wrong_person", "wrong_time", "wrong_words", "not_needed"],
+    slack: ["wrong_person", "wrong_time", "wrong_words", "not_needed"],
+    invite: ["wrong_person", "wrong_time", "not_needed"],
+    event: ["wrong_person", "wrong_time", "not_needed"],
+    payment: ["wrong_amount", "wrong_time", "not_needed"],
