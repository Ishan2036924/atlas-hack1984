+// Settings › Atlas Shield › What the AI saw (Open Pseudonym): ?screen=settings&settings=aisaw (or &settings=shield for
+// its row); &pseudonym=off (not on for this account: no row), empty (no messages yet), error (the list fails), worst
+// (long words, an unbroken address, emoji and RTL text, many rows, a receipt that doesn't hold up). Each row's line is
+// worked out from the same marks its sheet shows (lib/pseudonym.wordsOf), as the server does.
+import { type Mark, type PseudonymState, type StandIns, type Turn, type TurnPage, type TurnRow, wordsOf } from "../lib/pseudonym";
+
+const AT = (minutes: number) => new Date(Date.now() - minutes * 60_000).toISOString();
+const SIG = "eyJhbGciOiJFZERTQSIsImtpZCI6InNoYS0yNTY6eCIsInR5cCI6Im9wbi1lZ3Jlc3MrandzIn0.eyJvcG4iOiIwLjEifQ.c2ln";
+
+type Fixture = { job: string; model: string; calls: number; real: string; seen: string; stand: Array<[string, string]>; total: StandIns; bad?: boolean };
+
+function marks(text: string, parts: Array<[string, string]>): Mark[] {
+  return parts.map(([needle, kind]) => {
+    const at = text.indexOf(needle);
+    return [at, at + needle.length, kind];
+  });
+}
+
+const PLAIN: Fixture[] = [
+  {
+    job: "chat", model: "gpt-5.6-luna", calls: 3,
+    real: "Please email the receipt to jordan.lee@example.com and pay the deposit with my card 4111 1111 1111 1111. Copy sam.rivera@example.com.",
+    seen: "Please email the receipt to [EMAIL_1] and pay the deposit with my card [CARD_1]. Copy casey.hart@harbor.example.",
+    stand: [["[EMAIL_1]", "EMAIL"], ["[CARD_1]", "CARD"], ["casey.hart@harbor.example", "EMAIL"]],
+    total: { CARD: 1, EMAIL: 3 },
+  },
+  {
+    job: "agent", model: "gpt-5.6-luna", calls: 5,
+    real: "Text the plumber at 617-555-0182 that Thursday at 9 works.",
+    seen: "Text the plumber at [PHONE_1] that Thursday at 9 works.",
+    stand: [["[PHONE_1]", "PHONE"]],
+    total: { PHONE: 1, EMAIL: 2 },
+  },
+  { job: "chat_title", model: "gpt-5-nano", calls: 1, real: "What's a good stretch routine for a long flight?", seen: "What's a good stretch routine for a long flight?", stand: [], total: {} },
+  {
+    job: "memory_capture", model: "gpt-5-nano", calls: 1,
+    real: "My landlord is Robin Okafor, rent is due on the 3rd.",
+    seen: "My landlord is [PERSON_A], rent is due on the 3rd.",
+    stand: [["[PERSON_A]", "PERSON"]],
+    total: { PERSON: 1 },
+  },
+];
+
+const WORST: Fixture = {
+  job: "chat", model: "gpt-5.6-luna", calls: 3, bad: true,
+  real: "Sende die Unterlagen an Zoë Bérénice Montgomery-Vasquez-Okonkwo-Hernández, sehr_lange_adresse.ohne.umbruch.und.punkte@sehr-lange-domain-ohne-ende.example.org, Tel. +44 20 7946 0958 🙂 שלום",
+  seen: "Sende die Unterlagen an Zoë Bérénice Montgomery-Vasquez-Okonkwo-Hernández, [EMAIL_1], Tel. 020 7946 0123 🙂 שלום",
+  stand: [["[EMAIL_1]", "EMAIL"], ["020 7946 0123", "PHONE"]],
+  total: { EMAIL: 1, PHONE: 1, CARD: 2, ORG: 1 },
+};
+
+function turnOf(id: string, at: string, f: Fixture): Turn {
+  const m = marks(f.seen, f.stand);
+  const calls = Array.from({ length: f.calls }, (_, i) => ({
+    seq: i + 1,
+    at: new Date(Date.parse(at) + i * 2100).toISOString(),
+    model: f.model,
+    payload: `sha-256:Qm9vdHN0cmFwcGVkUGF5bG9hZERpZ2Vz${String(i).padStart(11, "x")}`,
+    stand_ins: f.total,
+    ok: !(f.bad && i === 1),
+    why: f.bad && i === 1 ? "changed" : null,
+    token: SIG,
+  }));
+  return { id, at, job: f.job, seen: f.seen, real: f.real, marks: m, words: wordsOf(f.seen, m), stand_ins: f.total, ok: calls.every((c) => c.ok), calls };
+}
+
+export function pseudonymPreview(params: URLSearchParams) {
+  const mode = params.get("pseudonym");
+  const ok = <T,>(v: T) => new Promise<T>((r) => setTimeout(() => r(v), 120));
+  const state: PseudonymState = mode === "off" ? { enabled: false } : { enabled: true, key: { kid: "sha-256:Wm9vT2ZmbGluZVByZXZpZXdLZXlJZA" } };
+  const fixtures = mode === "empty" ? [] : mode === "worst" ? Array.from({ length: 12 }, (_, i) => (i % 3 === 0 ? WORST : PLAIN[i % PLAIN.length])) : PLAIN;
+  const turns = fixtures.map((f, i) => turnOf(`7f0b2c1e-0000-4000-8000-${String(i).padStart(12, "0")}`, AT(4 + i * 90), f));
+  const rows: TurnRow[] = turns.map((t) => ({ id: t.id, at: t.at, job: t.job, model: t.calls[0].model, calls: t.calls.length, words: t.words, stand_ins: t.stand_ins }));
+  return {
+    pseudonym: () => ok(state),
+    pseudonymTurns: (before?: string): Promise<TurnPage> =>
+      mode === "error" ? Promise.reject(new Error("preview")) : ok({ turns: rows.filter((r) => !before || r.at < before).slice(0, 20), more: false }),
+    pseudonymTurn: (id: string): Promise<Turn> => ok(turns.find((t) => t.id === id) ?? turns[0]),
+  };
+}
