+// A Done answer is the model's own words, written in markdown as chat's are: it shows the way chat does (bold, lists),
+// through the same renderer (ui/Markdown: text goes in as text, never HTML), never as raw asterisks and dashes.
+import { act, cleanup, render, screen } from "@testing-library/react";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+
+import { FIXTURE } from "../../lib/agentFixture";
+import type { RunView } from "../../lib/agentRun";
+import { AgentMode } from "./AgentMode";
+import { InQuery, QUIET } from "./usageHarness";
+import { createFakeAgentModeApi } from "./fakeApi";
+
+vi.mock("../../ui/agent/Perch", () => ({ Perch: () => <span data-perch /> }));
+vi.mock("../../lib/dictation", () => ({ useDictation: () => ({ state: "idle", error: null, retry: null, seconds: 0, max: null, say: "", toggle: () => {}, stop: () => {} }) }));
+
+const had = window.matchMedia;
+function viewport(layout: "phone" | "wide") {
+  const [width, landscape] = layout === "phone" ? [390, false] : [1440, true];
+  window.matchMedia = ((q: string) => {
+    const min = /min-width:\s*(\d+)px/.exec(q);
+    const matches = min ? width >= Number(min[1]) : q.includes("landscape") ? landscape : false;
+    return { matches, media: q, addEventListener() {}, removeEventListener() {}, addListener() {}, removeListener() {}, onchange: null, dispatchEvent: () => false };
+  }) as typeof window.matchMedia;
+}
+beforeEach(() => vi.useFakeTimers());
+afterEach(() => {
+  cleanup();
+  vi.useRealTimers();
+  window.matchMedia = had;
+});
+const flush = async (ms: number) => {
+  for (let left = ms; left > 0; left -= 50) await act(async () => void (await vi.advanceTimersByTimeAsync(Math.min(left, 50))));
+};
+
+const ANSWER = "Tomorrow looks open. [Seen in School: academic calendar]\n\n- **Class schedule:** No classes [Seen in School: academic calendar]\n- **Best open day:** **Wednesday, November 11**\n- One reminder at 9:00 AM\n- Problem set 4 is due Thursday\n- Office hours Tuesday and Thursday\n- Club meeting Wednesday at 6:00 PM\n- Gym is free from 4:00 to 5:30 PM [My guess]";
+const plain = FIXTURE.plain[FIXTURE.plain.length - 1].view;
+const done: RunView = { ...plain, done: { ...(plain.done as NonNullable<RunView["done"]>), answer: ANSWER } };
+
+function showDone(layout: "phone" | "wide", phone: boolean) {
+  viewport(layout);
+  const api = createFakeAgentModeApi({ script: [done], started: true, latest: done });
+  render(
+    <InQuery>
+      <AgentMode usageApi={QUIET} phase="evening" onMode={() => {}} api={api} approvals={{ approve: vi.fn() } as never} from={{ run: done.id }} phone={phone} />
+    </InQuery>,
+  );
+}
+
+describe.each([
+  ["a laptop", "wide", false],
+  ["a phone (the stage)", "phone", false],
+  ["the phone face", "phone", true],
+] as const)("the Done answer on %s", (_name, layout, phone) => {
+  it("renders its markdown as chat does: bold is bold, a list is a list, no raw asterisks", async () => {
+    showDone(layout, phone);
+    await flush(2400);
+    expect(screen.getByText("Class schedule:").tagName).toBe("STRONG");
+    expect(screen.getByText("Wednesday, November 11").tagName).toBe("STRONG");
+    expect(screen.getAllByRole("listitem").some((li) => li.textContent?.includes("No classes"))).toBe(true);
+    expect(document.body.textContent).not.toContain("**");
+    expect(document.body.textContent).toContain("Tomorrow looks open.");
+    // where the words were seen is a small chip, never the raw brackets; a long list keeps every line
+    expect(document.body.textContent).not.toMatch(/\[(Seen in|My guess)/);
+    expect(document.querySelectorAll('[data-label="seen"]').length).toBe(2);
+    expect(document.querySelector('[data-label="guess"]')?.textContent).toBe("My guess");
+    expect(screen.getAllByRole("listitem").filter((li) => li.closest("main, [data-face], body")).length).toBeGreaterThanOrEqual(7);
+  });
+});
+
+it("on the phone face the answer sits on the rows' light glass, so its ink reads on any sky (the night's too)", async () => {
+  showDone("phone", true);
+  await flush(2400);
+  const panel = screen.getByText("Class schedule:").closest("[data-answer]");
+  expect(panel).toBeTruthy();
+  expect(panel?.className).toContain("bg-surface-panel");
+  expect(panel?.className).toContain("backdrop-blur");
+});
