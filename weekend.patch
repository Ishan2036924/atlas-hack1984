@@ -0,0 +1,49 @@
+// Want to say why? (the learning loop): after you say Not now to a card, an optional row of reasons that fit the action
+// (lib/agentScores reasonsFor: at most four, then Something else). One tap keeps a code (lifeos.learnsignals
+// NO_REASONS), never your words; the judge reads it as what the agent learns from, never as a lost point. Skipping it
+// is fine: nothing asks again. The picked chip stays, filled, and a tap on it opens the chips again to change it (the
+// server keeps one reason per card). A failed send keeps the chips so another tap can try.
+import { useEffect, useRef, useState } from "react";
+
+import { NO_WORDS, reasonsFor } from "../../lib/agentScores";
+import { Chip } from "../../ui/primitives/Chip";
+
+export function NoReasons({ kind, onReason }: { kind?: string; onReason: (reason: string) => Promise<boolean> }) {
+  const [picked, setPicked] = useState<string | null>(null);
+  const [sending, setSending] = useState(false);
+  const root = useRef<HTMLDivElement>(null);
+  // the question appears under a card that may sit low in a chat: bring it into view once, without a jump
+  useEffect(() => {
+    root.current?.scrollIntoView?.({ block: "nearest" });
+  }, []);
+  const pick = async (code: string) => {
+    if (sending) return;
+    setSending(true);
+    const ok = await onReason(code);
+    setSending(false);
+    if (ok) setPicked(code);
+  };
+  return (
+    <div ref={root} className="flex flex-col gap-2.5">
+      {picked ? (
+        <span role="status" className="flex flex-wrap items-center gap-3 text-small leading-snug text-ink-2">
+          <Chip size="lg" variant="selected" icon="check" onClick={() => setPicked(null)}>
+            {NO_WORDS[picked]}
+          </Chip>
+          Thanks. It learns from this.
+        </span>
+      ) : (
+        <>
+          <span className="text-small leading-snug text-ink-2">Want to say why? Only if you like.</span>
+          <div role="group" aria-label="Why not" className="flex flex-wrap gap-3">
+            {reasonsFor(kind).map((code) => (
+              <Chip key={code} size="lg" disabled={sending} onClick={() => void pick(code)}>
+                {NO_WORDS[code]}
+              </Chip>
+            ))}
+          </div>
+        </>
+      )}
+    </div>
+  );
+}
