+    // the picked chip stays, filled; a tap on it opens the chips again to change it
+    fireEvent.click(screen.getByRole("button", { name: "Wrong time" }));
+    expect(screen.getAllByRole("button")).toHaveLength(5);
+  });
+
+  it("keeps the chips when the send fails, so another tap can try", async () => {
