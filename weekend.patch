diff --git a/web/src/screens/ChatPaidLine.test.tsx b/web/src/screens/ChatPaidLine.test.tsx
new file mode 100644
index 00000000..c6bad27e
--- /dev/null
+++ b/web/src/screens/ChatPaidLine.test.tsx
@@ -0,0 +1,138 @@
+// The Stripe test payments (lifeos.payments): after a test payment, a calm line under the answer says where it stands
+// ("Holding $12.00 for Blue Bottle. It's paid at … unless you cancel it in Payments.", then "Paid $12.00 to Blue Bottle
+// in test mode") with one button, Open in Payments. The chat carries no payment controls (Ishan, 2026-11-07): Cancel,
+// Refund and the rest live in Settings › Payments. The step carries the chip from the pay tool's own result (the
+// server's lifeos.paychip); the line is drawn only from a chip that passes lib/payChip, and only from pay's own step.
+import { QueryClient, QueryClientProvider } from "@tanstack/react-query";
+import { cleanup, fireEvent, render, screen } from "@testing-library/react";
+import { afterEach, describe, expect, it, vi } from "vitest";
+
+import type { Api } from "../lib/api";
+import { applyEvent, emptyTurn } from "../lib/chat";
+import { money, paidOf } from "../lib/payChip";
+import { Chat } from "./Chat";
+
+afterEach(cleanup);
+
+const ID = "3f2b8c1e-5d4a-4c3b-9a2e-1f0e9d8c7b6a";
+const later = () => new Date(Date.now() + 23 * 3600_000).toISOString();
+const soon = () => new Date(Date.now() + 8 * 60_000).toISOString();
+const paid = (over: Record<string, unknown> = {}) => ({ kind: "paid", amount_cents: 1200, currency: "usd", payee: "Blue Bottle", payment_id: ID, refund_until: later(), ...over });
+const PAY_STEP = (chip: unknown = paid()) => [{ name: "pay", label: "Pay (test mode)", ok: true, chip }];
+
+const detail = (status: string, over: Record<string, unknown> = {}) => ({
+  payment: { id: ID, created_at: new Date().toISOString(), amount_cents: 1200, currency: "usd", payee: "Blue Bottle", reason: "team coffee", status, stripe_id: "pi_test000001", capture_at: status === "held" ? soon() : null, captured_at: null, canceled_at: null, refunded_cents: 0, refund_left_cents: status === "paid" ? 1200 : 0, refund_until: later(), dispute: null, actions: status === "held" ? ["cancel", "problem", "evidence"] : status === "paid" ? ["refund", "problem", "evidence"] : ["problem", "evidence"], test_mode: true, ...over },
+  events: [],
+});
+
+function fakeApi(steps: unknown[], extra: Record<string, unknown> = {}) {
+  return {
+    conversations: vi.fn(async () => ({ items: [{ id: "c-1", title: "Coffee", updated_at: new Date().toISOString(), archived: false, preview: "" }], more: false })),
+    conversationMessages: vi.fn(async () => ({
+      messages: [
+        { id: 1, role: "user", text: "Pay $12 to Blue Bottle for the team coffee", status: "done", steps: [] },
+        { id: 2, role: "assistant", text: "Done.", status: "done", steps },
+      ],
+      more: false,
+    })),
+    warm: vi.fn(async () => ({ warm: true })),
+    ...extra,
+  };
+}
+
+function show(steps: unknown[], extra: Record<string, unknown> = {}, onPayments?: (id: string) => void) {
+  render(
+    <QueryClientProvider client={new QueryClient({ defaultOptions: { queries: { retry: false } } })}>
+      <Chat api={fakeApi(steps, extra) as unknown as Api} wide initialConversation="c-1" onPayments={onPayments} />
+    </QueryClientProvider>,
+  );
+}
+
+describe("the chip, read from the server's words", () => {
+  it("accepts exactly a test payment's amount, currency, payee, id, refund time and hold time", () => {
+    const c = paidOf(paid({ capture_at: soon() }))!;
+    expect(c).toMatchObject({ amountCents: 1200, currency: "usd", payee: "Blue Bottle", paymentId: ID });
+    expect(c.captureAt).toBeGreaterThan(Date.now());
+    expect(paidOf(paid())?.captureAt).toBeNull();
+    expect(money(5000)).toBe("$50.00");
+    expect(money(50)).toBe("$0.50");
+  });
+
+  it.each([
+    ["not an object", "Paid $12"],
+    ["another kind", paid({ kind: "remembered" })],
+    ["over the pilot's cap", paid({ amount_cents: 5001 })],
+    ["a fraction of a cent", paid({ amount_cents: 12.5 })],
+    ["another currency", paid({ currency: "eur" })],
+    ["no payee", paid({ payee: "  " })],
+    ["an id that isn't one", paid({ payment_id: "../../x" })],
+    ["no refund time", paid({ refund_until: "soon" })],
+    ["a hold time that isn't one", paid({ capture_at: "soon" })],
+  ])("refuses %s", (_name, value) => {
+    expect(paidOf(value)).toBeNull();
+  });
+});
+
+describe("the live turn", () => {
+  it("keeps the chip only from pay's own finished step", () => {
+    let t = applyEvent(emptyTurn("hi"), "tool", { phase: "start", name: "pay", label: "Pay (test mode)" });
+    const chip = paid();
