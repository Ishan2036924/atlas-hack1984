+FLAG = "LIFEOS_PAYMENTS"  # owner | anything else (unset) = off
+KEY = "STRIPE_TEST_KEY"
+TOOL = "pay"
+REFUND_TOOL = "pay_refund"  # the refund's receipt (a tap in the app, never a tool the model has)
+ARGS = ("amount_cents", "currency", "payee", "reason")
