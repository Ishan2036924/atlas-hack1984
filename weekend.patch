+                                   theirs, 503 while the tables are missing (the migration hasn't run yet).
+GET  /v1/agents/{id}/scores      → how the judge scored the agent's runs (lifeos.judge.agent_scores): counts, the
+                                   average, safety failures, common reasons, the last verdicts. 404 for an agent that
+                                   isn't theirs."""
+
+from __future__ import annotations
+
+import uuid
+from collections.abc import Callable
+from datetime import UTC, datetime
+from typing import Any
+
+import psycopg
+from fastapi import Depends, FastAPI, HTTPException
+from pydantic import BaseModel, ConfigDict, Field
+
+from lifeos import agents, judge, learnsignals
+from lifeos.api import store
+
+MISSING = "Learning isn't set up on this server yet"
+
+
+class Signal(BaseModel):
+    model_config = ConfigDict(extra="forbid")
+    kind: str = Field(max_length=20)
+    subject: str = Field(max_length=20)
+    subject_id: str = Field(max_length=100)
+    value: int | None = None
+    reason: str | None = Field(default=None, max_length=40)
+    attrs: dict[str, str] | None = None
+
+
+def mount(app: FastAPI, limited: Callable[[str], Any]) -> None:
+    @app.post("/v1/signals")
+    def signals_post(body: Signal, user: str = Depends(limited("learning"))) -> dict[str, Any]:
+        if (
+            body.kind not in learnsignals.ROUTE_KINDS
+        ):  # picks and habit marks are the server's (review HIGH 1)
+            raise HTTPException(422, f"kind is one of {', '.join(learnsignals.ROUTE_KINDS)}")
+        try:
+            got = store.run(user, lambda conn: learnsignals.record(conn, user, body.model_dump()))
+        except learnsignals.Refused as e:
+            raise HTTPException(422, str(e)) from None
+        except learnsignals.NotFound as e:
+            raise HTTPException(404, str(e)) from None
+        except psycopg.errors.UndefinedTable:
+            raise HTTPException(503, MISSING) from None
+        return {"signal": got}
+
+    @app.get("/v1/agents/{agent_id}/scores")
+    def agent_scores(agent_id: uuid.UUID, user: str = Depends(limited("learning"))) -> dict[str, Any]:
+        def read(conn: psycopg.Connection) -> dict[str, Any]:
+            a = agents.get(conn, user, str(agent_id))
+            return judge.agent_scores(conn, user, a["id"], now=datetime.now(UTC))
+
+        try:
+            return store.run(user, read)
+        except agents.NotFound:
+            raise HTTPException(404, "no such agent") from None
+        except psycopg.errors.UndefinedTable:
+            raise HTTPException(503, MISSING) from None
diff --git a/mcp/src/lifeos/api/payments.py b/mcp/src/lifeos/api/payments.py
